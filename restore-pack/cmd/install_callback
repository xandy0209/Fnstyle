#!/bin/bash
# ---------------------------------------------------------------------------
# FnStyle 系统还原（一次性工具）—— 安装即排程还原
#
# 用途：FnStyle 卸载后登录页/桌面仍是应用最后配置的那套样式，装上本工具
#       即可把系统恢复成 fnOS 原生样式。装完可直接卸载本工具。
#
# ⚠★ 2026-11-14 真机实测：在**安装回调里同步写 /usr/trim/www/** 会触发
#   fnOS nginx 的 ngx_http_trim_recover（stop nginx → 从 www.zip 重建 →
#   start，约 2~10 秒），把应用中心这条安装/卸载请求切断 → 前端
#   "Failed to fetch" → 「无法卸载 / 安装失败」。
#   因此还原必须拆成两段（与主应用 uninstall_callback 同一套铁律）：
#     ① 同步：只中和 www.zip / tow / raw（不碰 www/，不触发 nginx 重建）
#     ② 立刻 exit 0，让应用中心请求正常返回
#     ③ setsid + nohup 后台进程延迟 12 秒后写 www/、两轮复查、自检
#
# 还原核心复用 cmd/restore_system.py（与主应用同一份源码，由 build.sh 同步）。
# ---------------------------------------------------------------------------
set -uo pipefail

CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
GUARD="${FNSTYLE_GUARD_DIR:-/usr/trim/share/.restore/fnstyle-guard}"
RESTORE="${FNSTYLE_RESTORE_ROOT:-/usr/trim/share/.restore}"
WWW="${FNSTYLE_WWW:-/usr/trim/www}"
LOG="${GUARD}/restore_now.log"
SCRIPT="${GUARD}/restore_system.py"
DEFER="${GUARD}/restore_deferred.sh"
DATA="${FNSTYLE_DATA_DIR:-${GUARD}/run-data}"
DELAY="${FNSTYLE_RESTORE_DELAY:-12}"

mkdir -p "$GUARD" "$DATA" 2>/dev/null || true
echo "" >> "$LOG" 2>/dev/null || true
echo "===== $(date '+%F %T') 一键还原开始（install_callback，异步 v3）=====" >> "$LOG" 2>/dev/null || true

# 两种脚本都投到系统级 guard：应用目录随时可能被卸载流程删掉
[ -f "${CMD_DIR}/restore_system.py" ] && \
    cp -f "${CMD_DIR}/restore_system.py" "$SCRIPT" 2>/dev/null && \
    chmod 755 "$SCRIPT" 2>/dev/null || true
[ -f "${CMD_DIR}/restore_deferred.sh" ] && \
    cp -f "${CMD_DIR}/restore_deferred.sh" "$DEFER" 2>/dev/null && \
    chmod 755 "$DEFER" 2>/dev/null || true

# ---- 自愈：解除旧版 FnStyle 卸载回调的「同步写 www/」武装 --------------
# 旧版（v1/v2）uninstall_callback 会在回调里同步写 /usr/trim/www/，
# 触发 nginx 停启重建 → 应用中心卸载请求被切断 → 「无法卸载 fnstyle /
# Failed to fetch」。用户因此可能卡在「卸载不掉、也就装不上新包」的死循环。
# 装本工具时把旧回调替换成安全 no-op（原文件备份为 .fnstyle-orig），
# 用户即可正常卸载旧版；系统样式还原由本工具负责，不会因此缺失。
disarm_legacy_uninstall() {
    local d f
    for d in "${FNSTYLE_TARGET_APP_DIR:-/var/apps/fnstyle}" \
             /usr/local/apps/@appcenter/fnstyle; do
        f="$d/cmd/uninstall_callback"
        [ -f "$f" ] || continue
        # 已是新版（带 --skip-www）或已被本工具处理过 → 不再动
        grep -q -- '--skip-www' "$f" 2>/dev/null && return 0
        grep -q 'FnStyle 系统还原工具替换为安全 no-op' "$f" 2>/dev/null && return 0
        cp -f "$f" "$f.fnstyle-orig" 2>/dev/null || true
        cat > "$f" <<'NOOP'
#!/bin/bash
# 由 FnStyle 系统还原工具替换为安全 no-op（原文件见 .fnstyle-orig）。
# 旧版回调同步写 /usr/trim/www/ 会触发 nginx 停启重建，
# 切断应用中心的卸载请求（前端报 Failed to fetch）。
exit 0
NOOP
        chmod 755 "$f" 2>/dev/null || true
        echo "已解除旧版卸载回调：${f}（原文件备份 .fnstyle-orig）" \
            >> "$LOG" 2>/dev/null || true
        return 0
    done
}
disarm_legacy_uninstall

# 先掐断「还原之后又写回来」的复活源（不写 www/，安全）
if [ -z "${FNSTYLE_SKIP_KILL:-}" ] && command -v pgrep >/dev/null 2>&1; then
    for pat in apply_worker.sh recheck.sh; do
        for pid in $(pgrep -f "$pat" 2>/dev/null); do
            [ "$pid" = "$$" ] && continue
            kill -9 "$pid" 2>/dev/null || true
        done
    done
fi

if [ "${FNSTYLE_SYNC_RESTORE:-0}" = "1" ]; then
    # 仅本地沙箱验证使用：同步跑完整还原（生产绝不进入此分支）
    echo "同步验证模式：立即执行完整还原" >> "$LOG" 2>/dev/null || true
    if command -v python3 >/dev/null 2>&1 && [ -f "$SCRIPT" ]; then
        python3 "$SCRIPT" --data-dir "$DATA" --www "$WWW" \
            --restore "$RESTORE" --guard "$GUARD" --settle 5 >> "$LOG" 2>&1
        python3 "$SCRIPT" --data-dir "$DATA" --www "$WWW" \
            --restore "$RESTORE" --guard "$GUARD" --verify-only >> "$LOG" 2>&1 || true
    fi
else
    # ① 同步阶段：只中和还原源（www.zip / tow / raw），绝不触碰 www/
    if command -v python3 >/dev/null 2>&1 && [ -f "$SCRIPT" ]; then
        python3 "$SCRIPT" --data-dir "$DATA" --www "$WWW" \
            --restore "$RESTORE" --guard "$GUARD" \
            --skip-www --settle 0 >> "$LOG" 2>&1 || true
    fi
    printf '%s\n' "$(date '+%F %T')" > "${GUARD}/restore_pending" 2>/dev/null || true

    # ② 排程后台完整还原（延迟避开应用中心在途 HTTP 请求）
    if [ -f "$DEFER" ]; then
        if command -v setsid >/dev/null 2>&1; then
            setsid nohup env \
                FNSTYLE_GUARD_DIR="$GUARD" FNSTYLE_WWW="$WWW" \
                FNSTYLE_RESTORE_ROOT="$RESTORE" FNSTYLE_DATA_DIR="$DATA" \
                FNSTYLE_RESTORE_DELAY="$DELAY" \
                bash "$DEFER" >> "$LOG" 2>&1 < /dev/null &
        else
            nohup env \
                FNSTYLE_GUARD_DIR="$GUARD" FNSTYLE_WWW="$WWW" \
                FNSTYLE_RESTORE_ROOT="$RESTORE" FNSTYLE_DATA_DIR="$DATA" \
                FNSTYLE_RESTORE_DELAY="$DELAY" \
                bash "$DEFER" >> "$LOG" 2>&1 < /dev/null &
        fi
        echo "已排程后台还原（延迟 ${DELAY}s）" >> "$LOG" 2>/dev/null || true
    else
        # 极简兜底：无 python3 / 无执行器时，延迟做最小中和
        setsid nohup bash -c '
            sleep "$1"
            for d in "$2" "$3/tow"; do
                [ -d "$d" ] || continue
                mkdir -p "$d/deskdata" 2>/dev/null || true
                printf "{\"__fnstyleDisabled\": true}\n" > "$d/deskdata/fnstyle.json" 2>/dev/null || true
                for s in fnstyle-login.js fnstyle-runtime.js; do
                    printf "/*! __FNSTYLE_RESTORED_NOOP__ */\n" > "$d/$s" 2>/dev/null || true
                done
                rm -rf "$d/deskdata/fnstyle" 2>/dev/null || true
            done
        ' _ "$DELAY" "$WWW" "$RESTORE" >> "$LOG" 2>&1 < /dev/null &
    fi
fi

echo "===== $(date '+%F %T') 一键还原排程结束 =====" >> "$LOG" 2>/dev/null || true
echo "[fnstyle-restore] 还原已排程（约 ${DELAY}s 后完成，请强刷浏览器）；日志：${LOG}"
exit 0
