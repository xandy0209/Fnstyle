#!/bin/bash
# ---------------------------------------------------------------------------
# 一次性还原工具：没有常驻服务。
#
# start 会**再排程一次还原** —— 用户不必重新安装包，只要从应用中心
# 打开本工具（或卸载它）就能重复触发，覆盖「第一次执行时后台进程还在写」
# 的情况。
#
# ⚠️ 绝不在回调里同步写 /usr/trim/www/：那会触发 fnOS nginx 停启重建，
#    切断应用中心在途请求 → "Failed to fetch"。统一走 install_callback
#    的「同步中和还原源 + 后台延迟完整还原」两段式流程。
# ---------------------------------------------------------------------------
set -uo pipefail
CB="$(cd "$(dirname "$0")" && pwd)/install_callback"

case "${1:-}" in
    start|restart|reload)
        [ -f "$CB" ] && bash "$CB" || true
        exit 0
        ;;
    stop|status|*) exit 0 ;;
esac
