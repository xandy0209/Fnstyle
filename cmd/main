#!/bin/bash
# ---------------------------------------------------------------------------
# FnStyle —— 生命周期主控脚本（start / stop / status）
#
# 本应用提供三种访问方式，**同一份代码、同一份数据**：
#   1. 短地址（推荐）：/app/fnstyle
#      本应用自己监听一个 unix socket（<target>/fnstyle.sock），fnOS 网关整段反代过来，
#      与 Fndesk（/app/fndesk）、QLink2Desktop（/app/qlink2desktop）同一机制。
#      走网关鉴权，需要 fnOS 登录态。
#   2. 长地址（兼容）：/cgi/ThirdParty/fnstyle/index.cgi/
#      走 fnOS 内置 CGI 分发器，纯 bash 实现，不依赖 python3，作为短地址不可用时的兜底。
#   3. 独立 HTTP 服务：监听 service_port（默认 9910），供 QLink2Desktop 等
#      以 HTTPS 反代 —— 因为 fnOS 网关的 CGI 路径强制校验 token，无法被反向
#      代理直接访问；而 index.cgi 自身零鉴权，所以起一个本地 CGI 包装服务即可。
#
# 数据存储在 data-share（/volN/@appshare/fnstyle/deskdata），三个入口完全一致。
#
# ⚠️ 可移植性（打包要求）：
#   - 不硬编码 /vol1：不同设备系统盘可能是 vol2/vol3。
#     统一走 /var/apps/<app>/shares/<name> 软链 + TRIM_* 环境变量兜底。
#   - 不依赖手工创建的 systemd 单元：fpk 无法把 unit 文件装进 /etc/systemd/system/，
#     所以这里用 pidfile + nohup 自管进程，由 fnOS 应用中心调用 start/stop。
# ---------------------------------------------------------------------------
set -uo pipefail

APP_NAME="fnstyle"
# FNSTYLE_APP_ROOT 仅用于调试/测试时指向别处的安装目录；
# fnOS 正常运行时走标准软链 /var/apps/<app>/target。
APP_ROOT="${FNSTYLE_APP_ROOT:-/var/apps/${APP_NAME}/target}"
UI_DIR="${APP_ROOT}/ui"
SERVER="${UI_DIR}/fnstyle_server.py"
PORT="${TRIM_SERVICE_PORT:-${FNSTYLE_PORT:-9910}}"

# ---- 数据共享目录：shares 软链 → TRIM_DATA_SHARE_PATHS → /vol1（老设备兜底）----
resolve_share_root() {
    local p
    for p in "/var/apps/${APP_NAME}/shares/${APP_NAME}" \
             "/var/apps/${APP_NAME}/share/${APP_NAME}"; do
        if [ -d "$p" ]; then printf '%s' "$p"; return 0; fi
    done
    if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
        p="${TRIM_DATA_SHARE_PATHS%%:*}"
        if [ -n "$p" ] && [ -d "$p" ]; then printf '%s' "$p"; return 0; fi
    fi
    printf '%s' "/vol1/@appshare/${APP_NAME}"
}
SHARE_ROOT="$(resolve_share_root)"
DATA_DIR="${SHARE_ROOT}/deskdata"

# ---- 运行时数据目录：优先用 fnOS 提供的 TRIM_PKGVAR ----
RUN_DIR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"
PID_FILE="${RUN_DIR}/fnstyle_server.pid"
LOG_FILE="${DATA_DIR}/server.log"

mkdir -p "${DATA_DIR}" "${RUN_DIR}" 2>/dev/null

log_err() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}"
    fi
    echo "$1" >&2
}

is_running() {
    [ -f "${PID_FILE}" ] || return 1
    local pid
    pid=$(cat "${PID_FILE}" 2>/dev/null)
    [ -n "${pid}" ] || return 1

    # ⚠️ 判据顺序很重要：**端口在听**是最强证据（直接说明服务活着，
    #    且不依赖 pidfile 正确性），放在最前面。
    #    9910 是本服务独占的端口，端口在听 ⇒ 服务进程在跑。
    if port_listening; then
        return 0
    fi

    # 端口没在听，但 pidfile 里的进程还活着 ⇒ 服务进程在、只是监听还没起来
    # （或正在退出）。这种情况仍算「在运行」，避免重复拉起第二个实例。
    # ⚠️ 不能只看 kill -0：进程是 root 跑的，普通用户 kill -0 会拿到 EPERM，
    #    于是 status 误报「未运行」，排障时白白走弯路。补一条 /proc 判据
    #    （/proc 对所有用户可读，且不受权限影响）。
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    fi
    if [ -d "/proc/${pid}" ]; then
        return 0
    fi
    if command -v ps >/dev/null 2>&1; then
        ps -p "${pid}" >/dev/null 2>&1 && return 0
    fi
    return 1
}

# 端口上是否有监听者。
# 用 ss（Linux 标准）；没有 ss 就退回「能不能连上」来判断。
port_listening() {
    if command -v ss >/dev/null 2>&1; then
        ss -tln 2>/dev/null | grep -q ":${PORT} " && return 0
        return 1
    fi
    if command -v curl >/dev/null 2>&1; then
        curl -s -o /dev/null --max-time 2 "http://127.0.0.1:${PORT}/" 2>/dev/null && return 0
        return 1
    fi
    return 1
}

# 网关 socket 是否**真的有人在监听**。
#
# ⚠️⚠️ 只判断「文件在、类型是 socket」是不够的 —— **冷 socket**
#    （文件在、但没有进程 listen）会 100% 骗过 -S 检查，而网关的表现
#    与「后端崩了」完全一样（502 Bad Gateway）。这正是本次故障的真身：
#    socket 文件一直都在，9910 也一直正常，只有 socket 没人监听。
#    所以必须做一次**真实连接**：连得上 ⇒ 有人在 listen ⇒ socket 是活的。
socket_ok() {
    [ -S "${APP_ROOT}/fnstyle.sock" ] || return 1
    # 用 python3 做一次真实连接探测（fnOS 自带 python3，
    # 且 fnstyle_server.py 本来就依赖它）。
    if command -v python3 >/dev/null 2>&1; then
        python3 - "${APP_ROOT}/fnstyle.sock" <<'PYEOF' >/dev/null 2>&1
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
try:
    s.connect(sys.argv[1])
except Exception:
    sys.exit(1)
finally:
    try:
        s.close()
    except Exception:
        pass
sys.exit(0)
PYEOF
        return $?
    fi
    # 没有 python3 就退回「文件在就算过」（至少能挡住普通文件）
    return 0
}

start_server() {
    # ⚠️⚠️ 2026-11-18 真机实测踩出来的坑（表现为桌面入口 502 Bad Gateway）：
    #
    #   旧逻辑只要 pidfile 里的进程还活着就直接 return 0「服务已在运行」。
    #   但 install_callback / upgrade_callback 会先 rm -f 掉 socket 文件
    #   （为了清掉上一次异常退出留下的**冷 socket**），此时旧进程还活着、
    #   却已经不再 bind 这个 socket 了 → 网关连上去没人应答 → 502。
    #
    #   即：**「进程活着」≠「socket 在监听」**。两者必须一起判断。
    #   冷 socket 的危害正在于：文件在、但没人 listen，网关的表现和
    #   「后端崩了」一模一样，只看 HTTP 层完全查不出原因。
    if is_running; then
        if socket_ok; then
            echo "服务已在运行 (pid=$(cat "${PID_FILE}" 2>/dev/null))，端口 ${PORT}"
            return 0
        fi
        # 进程活着但 socket 不在 → 强制重启，让新进程重新 bind。
        echo "检测到服务进程存活但网关 socket 缺失，重启服务以重建 socket..." >&2
        stop_server >/dev/null 2>&1 || true
        rm -f "${PID_FILE}" "${APP_ROOT}/fnstyle.sock" 2>/dev/null || true
        # ⚠️ 必须等旧进程真正退出再拉新的，否则两个实例会抢同一个 socket
        #    （旧进程退出时还会删掉 socket 文件，把新进程的 socket 一起删了）。
        local w=0
        while [ "${w}" -lt 20 ]; do
            port_listening || break
            sleep 0.5
            w=$((w + 1))
        done
        # 端口还没让出来（被别的进程占着）→ 后面会走到「端口被占用」分支报错
        sleep 0.5
    fi
    # 端口被别的进程占用 → 直接报错，避免「启动成功但页面其实是别人的」
    if command -v ss >/dev/null 2>&1 && ss -tln 2>/dev/null | grep -q ":${PORT} "; then
        log_err "端口 ${PORT} 已被其他进程占用，无法启动"
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        log_err "python3 不可用，无法启动独立 HTTP 服务"
        return 1
    fi
    if [ ! -f "${SERVER}" ]; then
        log_err "服务脚本不存在: ${SERVER}"
        return 1
    fi

    # setsid 让进程脱离当前会话（避免 CGI/父进程退出时被带走）。
    # 非 Linux 环境（如本地调试）没有该命令，回退到普通 nohup。
    export FNSTYLE_PORT="${PORT}"
    export FNSTYLE_UI_DIR="${UI_DIR}"
    export FNSTYLE_SERVER_LOG="${LOG_FILE}"
    # 网关短地址 /app/fnstyle：
    #   应用自己监听一个 unix socket，由 fnOS 网关整段反代过来
    #   （与 Fndesk / QLink2Desktop 同一机制）。
    #   ⚠️ gatewayPrefix 必须等于 /app/<应用名>，否则应用中心会**整段丢弃**
    #      gatewaySocket/gatewayPrefix 两个字段（静默丢弃，没有任何日志），
    #      短地址就永远打不开。这里正好满足：APP_NAME=fnstyle → /app/fnstyle。
    #   ⚠️ socket 文件必须在应用中心解析 ui/config 之前就存在，
    #      所以 install_callback 里也要先把服务拉起来（见 install_callback）。
    export FNSTYLE_SOCKET="${APP_ROOT}/fnstyle.sock"
    export FNSTYLE_GATEWAY_PREFIX="/app/${APP_NAME}"

    # ⚠️⚠️ v1.1.75 修复（表现为桌面入口 502 Bad Gateway）：
    #
    #   服务**必须**以 root 身份运行，有两个硬性原因：
    #     ① 网关 socket 要建在 ${APP_ROOT}/fnstyle.sock，
    #        而 ${APP_ROOT}（= /usr/local/apps/@appcenter/fnstyle）
    #        的 ACL 只授权了 fnstyle 用户和 root：
    #            user::rwx / user:fnstyle:rwx / other::r-x
    #        普通用户（含管理员 xandy0209）**没有写权限**，
    #        bind 会直接 [Errno 13] Permission denied →
    #        网关连不上 → 桌面入口 502，而 9910 直连一切正常。
    #     ② 存储卡的 SMART 数据靠 `smartctl /dev/sda` 采集，
    #        读裸块设备需要 root；降权到 fnstyle 用户会全部读失败
    #        （实测 "Smartctl open device: /dev/sda failed: Permission denied"）。
    #
    #   因此：应用中心（root）调用时直接跑；被普通用户手工调用时
    #   必须先用 sudo 提权，否则就会复现本次故障。
    if [ "$(id -u)" -ne 0 ]; then
        # 优先用交互式 sudo（应用中心场景下由 fnOS 自己传密码/授权）；
        # 失败则明确报错，不要静默地以低权限跑起来。
        if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
            exec sudo -E env \
                FNSTYLE_PORT="${FNSTYLE_PORT}" \
                FNSTYLE_UI_DIR="${FNSTYLE_UI_DIR}" \
                FNSTYLE_SERVER_LOG="${FNSTYLE_SERVER_LOG}" \
                FNSTYLE_SOCKET="${FNSTYLE_SOCKET}" \
                FNSTYLE_GATEWAY_PREFIX="${FNSTYLE_GATEWAY_PREFIX}" \
                bash "$0" start
        fi
        log_err "服务必须以 root 运行（网关 socket 目录权限 + SMART 采集需要 root）；请用 sudo 执行"
        return 1
    fi

    if command -v setsid >/dev/null 2>&1; then
        setsid nohup python3 "${SERVER}" >>"${LOG_FILE}" 2>&1 &
    else
        nohup python3 "${SERVER}" >>"${LOG_FILE}" 2>&1 &
    fi
    echo $! > "${PID_FILE}"

    # 最多等 10 秒确认服务可用。
    # 同时用 ss 与 curl 两条判据：某些精简系统没有 ss，单靠它会出现
    # 「服务其实起来了但脚本报超时」的假失败。
    local i=0
    while [ "${i}" -lt 20 ]; do
        if command -v ss >/dev/null 2>&1 && ss -tln 2>/dev/null | grep -q ":${PORT} "; then
            echo "独立 HTTP 服务已启动，端口 ${PORT}"
            break
        fi
        if command -v curl >/dev/null 2>&1 && \
           curl -s -o /dev/null --max-time 2 "http://127.0.0.1:${PORT}/" 2>/dev/null; then
            echo "独立 HTTP 服务已启动，端口 ${PORT}"
            break
        fi
        sleep 0.5
        i=$((i + 1))
    done

    # ⚠️ 9910 起来了 ≠ 网关短地址能用。socket 没 bind 上时，桌面入口
    #    会直接 502，而 9910 直连一切正常 —— 只看 HTTP 层永远查不出问题。
    #    所以这里必须单独确认 socket 真的建立了（-S 判类型，不是判存在）。
    local j=0
    while [ "${j}" -lt 10 ]; do
        if socket_ok; then
            echo "网关 socket 已就绪：${APP_ROOT}/fnstyle.sock"
            return 0
        fi
        sleep 0.5
        j=$((j + 1))
    done

    log_err "网关 socket 未建立（短地址 /app/${APP_NAME} 将不可用），详见 ${LOG_FILE}"
    return 1
}

stop_server() {
    # ⚠️ v1.1.75：服务以 root 运行（见 start_server 的说明），
    #    普通用户调用 stop 时 kill / rm 都会 EPERM（权限不足），
    #    结果「停了但进程还在」，甚至把 pidfile 删了导致状态失真。
    #    所以同样需要提权。
    if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
        exec sudo -E bash "$0" stop
    fi

    if ! is_running; then
        rm -f "${PID_FILE}" 2>/dev/null
        # 进程已被回收但 socket 文件可能还在（异常退出/被杀 -9 时服务来不及清）
        # 留着它会让网关连到一个死 socket → 桌面入口打不开
        rm -f "${APP_ROOT}/fnstyle.sock" 2>/dev/null
        echo "服务未运行"
        return 0
    fi
    local pid
    pid=$(cat "${PID_FILE}")
    kill "${pid}" 2>/dev/null
    local i=0
    while [ "${i}" -lt 20 ] && kill -0 "${pid}" 2>/dev/null; do
        sleep 0.2
        i=$((i + 1))
    done
    kill -9 "${pid}" 2>/dev/null
    rm -f "${PID_FILE}" 2>/dev/null
    rm -f "${APP_ROOT}/fnstyle.sock" 2>/dev/null
    echo "服务已停止"
    return 0
}

case "${1:-}" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    status)
        if is_running; then
            echo "运行中 (pid=$(cat "${PID_FILE}" 2>/dev/null), 端口 ${PORT})"
            exit 0
        fi
        echo "未运行"
        exit 3
        ;;
    *)
        log_err "未知的运行控制指令: ${1:-<空>}"
        exit 1
        ;;
esac
